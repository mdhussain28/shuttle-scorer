# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project -> Settings -> Environment Variables.

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Server-only. Used by the daily cleanup job. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Any long random string. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=change-me-to-a-long-random-string
